# docker compose settings for p4n4-api (copy to .env). Every P4N4_API_* variable
# from the README's Configuration table can also be set here.

# The p4n4 project to serve (absolute path; mounted read-only at the same path)
P4N4_PROJECT_DIR=/home/pi/my-p4n4-project

# Image tag, and where the host port is published (127.0.0.1: this host only;
# containers on p4n4-net use http://p4n4-api:8000 either way)
P4N4_API_VERSION=0.1.0
P4N4_API_BIND=127.0.0.1
P4N4_API_PUBLISH_PORT=8000

# With docker-compose.docker.yml: the Docker socket's group (stat -c %g /var/run/docker.sock)
# DOCKER_GID=

# P4N4_API_CORS_ORIGINS=http://localhost:8088
# P4N4_API_LOG_FORMAT=json
